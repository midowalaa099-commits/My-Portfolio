{
  "name": "mwz-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .prerender-build && node scripts/prerender.mjs && node scripts/performance-budget.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/retry.test.js",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "verify:preservation": "node scripts/verify-preservation.mjs",
    "check:site": "node scripts/check-site.mjs",
    "fonts:subset": "python3 scripts/subset-arabic-font.py",
    "check:performance": "node scripts/performance-budget.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepare:pages": "npm run build && npm run check:release && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
