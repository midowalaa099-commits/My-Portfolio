l bg-zinc-900 text-white\"\n                    >%DESCRIPTION%</textarea>\n\n                    <p data-error role=\"alert\" class=\"text-red-500 mt-2\"></p>\n\n                    <div class=\"flex justify-end gap-3 mt-4\">\n\n                        <a href=\"#/ideas/%ID%\"\n                           class=\"btn btn-outline\">\n                            Cancel\n                        </a>\n\n                        <button\n                            type=\"submit\"\n                            class=\"btn btn-warning\">\n                            Update Idea\n                        </button>\n\n                    </div>\n\n                </form>\n\n            </div>\n\n        </div>\n\n    </div>\n\n"}
