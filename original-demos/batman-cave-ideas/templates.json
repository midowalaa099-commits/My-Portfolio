{"card":"\n\n        <div class=\"card bg-zinc-950 border border-zinc-800 shadow-xl hover:border-yellow-500 hover:shadow-yellow-500/20 transition-all duration-300\">\n\n            <div class=\"card-body\">\n\n                <div class=\"flex justify-between items-center\">\n\n                    <h2 class=\"card-title text-yellow-400\">\n                        💡 Idea #%ID%\n                    </h2>\n\n                    <span class=\"badge badge-warning\">\n                        %STATE%\n                    </span>\n\n                </div>\n\n                <p class=\"text-zinc-300 break-words\">\n                    %DESCRIPTION%\n                </p>\n\n                <div class=\"card-actions justify-end mt-4\">\n\n                    <a href=\"#/ideas/%ID%\"\n                        class=\"btn btn-sm btn-outline\">\n                        View\n                    </a>\n\n                    <a href=\"#/ideas/%ID%/edit\"\n                        class=\"btn btn-sm btn-warning\">\n                        Edit\n                    </a>\n\n                </div>\n\n            </div>\n\n        </div>\n\n        ","empty":"\n\n    <div class=\"text-center py-20\">\n\n        <div class=\"text-7xl mb-4\">\n            🦇\n        </div>\n\n        <h2 class=\"text-2xl font-bold text-zinc-300\">\n            No Ideas Yet\n        </h2>\n\n        <p class=\"text-zinc-500 mt-2\">\n            Start by creating your first brilliant idea.\n        </p>\n\n    </div>\n\n    ","index":"\n    <div class=\"flex justify-between items-center mb-8\">\n\n        <div>\n            <h1 class=\"text-4xl font-black text-yellow-400\">\n                🦇 Idea Cave\n            </h1>\n\n            <p class=\"text-zinc-400 mt-2\">\n                Capture your best ideas before they disappear.\n            </p>\n        </div>\n\n        <a href=\"#/ideas/create\"\n            class=\"btn bg-yellow-500 hover:bg-yellow-400 text-black border-0 font-bold\">\n            + Create Idea\n        </a>\n\n    </div>\n\n    <div class=\"grid md:grid-cols-2 gap-6\">\n\n        %CARDS%\n\n    </div>\n\n    %EMPTY%\n\n","show":"\n    <div class=\"max-w-3xl mx-auto\">\n\n        <div class=\"card bg-zinc-950 border border-zinc-800 shadow-2xl\">\n\n            <div class=\"card-body\">\n\n                <div class=\"flex justify-between items-center\">\n\n                    <h1 class=\"text-3xl font-black text-yellow-400\">\n                        💡 Idea #%ID%\n                    </h1>\n\n                    <span class=\"badge badge-warning\">\n                        %STATE%\n                    </span>\n\n                </div>\n\n                <div class=\"divider\"></div>\n\n                <p class=\"text-xl text-zinc-200 leading-9 bg-zinc-900 p-6 rounded-xl border border-zinc-800\">\n                %DESCRIPTION%\n                </p>\n\n                <div class=\"divider\"></div>\n\n                <div class=\"flex gap-3 justify-end\">\n\n                    <a href=\"#/ideas\"\n                        class=\"btn btn-outline\">\n                        ← Back\n                    </a>\n\n                    <a href=\"#/ideas/%ID%/edit\"\n                        class=\"btn btn-warning\">\n                        ✏️ Edit\n                    </a>\n\n                    <form action=\"#/ideas/%ID%\" method=\"POST\">\n\n                        \n                        <input type=\"hidden\" name=\"_method\" value=\"DELETE\">\n\n                        <button\n                            class=\"btn btn-error\"\n                            onclick=\"return confirm('Delete this idea?')\">\n\n                            🗑 Delete\n\n                        </button>\n\n                    </form>\n\n                </div>\n\n            </div>\n\n        </div>\n\n    </div>\n\n","create":"\n\n    <div class=\"max-w-3xl mx-auto\">\n\n        <div class=\"card bg-zinc-950 border border-zinc-800 shadow-2xl\">\n\n            <div class=\